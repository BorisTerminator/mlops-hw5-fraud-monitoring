    {
      "id": 9,
      "title": "PostgreSQL: результаты по версии модели",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fraud-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fraud-postgres"
          },
          "rawSql": "SELECT model_version, count(*) AS scores,\n       avg(fraud_flag::double precision) AS flagged_fraction,\n       avg(score) AS mean_score, max(created_at) AS latest_write\nFROM scores WHERE $__timeFilter(created_at)\nGROUP BY model_version ORDER BY latest_write DESC;\n",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "description": "Число скоров и доля флагов каждой версии в выбранном интервале. Это решения модели, не подтверждённый фрод.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "flagged_fraction"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          }
        ]
      },
